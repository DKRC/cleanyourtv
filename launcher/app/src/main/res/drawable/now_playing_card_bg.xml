<?xml version="1.0" encoding="utf-8"?>
<!-- The Now playing card: the cards' scrim, and a white ring while focused (OK opens its media menu). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#8C000000" />
            <stroke android:width="2dp" android:color="#F5FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/now_playing_bg" />
</selector>
