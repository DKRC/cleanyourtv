<?xml version="1.0" encoding="utf-8"?>
<!-- The Home cards (weather, now playing): a 55% black scrim with the pills' hairline. Black rather than the
     pills' white glass because the cards sit where the scenes wallpapers brighten: measured over the 13 scenes
     in themes/meu-stick, 55% keeps every card text at 4.5:1 or better in the brightest letter-sized spot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#8C000000" />
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="16dp" />
</shape>
