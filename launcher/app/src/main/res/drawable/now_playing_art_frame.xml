<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline over the cover art (a View foreground, so it draws above the bitmap): keeps a white sleeve from
     reading as a bare square against the card. Same corners as now_playing_art. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="10dp" />
</shape>
